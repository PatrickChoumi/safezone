    "DisablePrivateBrowsing": true,

    "BlockAboutConfig": true,

    "Preferences": {
      "network.trr.mode": {
        "Value": 5,
        "Status": "locked"
      },
      "network.dns.disablePrefetch": {
        "Value": true,
        "Status": "locked"
      },
      "media.peerconnection.enabled": {
        "Value": false,
        "Status": "locked"
      }
    },

    "Proxy": {
      "Mode": "system",
      "Locked": true
    },

    "UserMessaging": {
      "ExtensionRecommendations": false
    }
  }
}
