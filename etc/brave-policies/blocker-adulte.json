{
  "_comment": "blocker-adulte - policy Brave (composant 3). Deployee dans /etc/brave/policies/managed/blocker-adulte.json. Reprend les policies Chromium et y ajoute les specificites Brave (Tor, VPN integre) qui contourneraient sinon entierement le resolveur local.",

  "DnsOverHttpsMode": "off",
  "DnsOverHttpsTemplates": "",
  "BuiltInDnsClientEnabled": false,
  "QuicAllowed": false,

  "IncognitoModeAvailability": 1,

  "SafeSitesFilterBehavior": 1,
  "ForceGoogleSafeSearch": true,
  "ForceYouTubeRestrict": 2,

  "ProxySettings": {
    "ProxyMode": "system"
  },

  "URLBlocklist": [
    "chrome://flags",
    "brave://flags",
    "chrome://net-internals",
    "brave://net-internals",
    "chrome://net-export",
    "brave://net-export"
  ],

  "URLAllowlist": [],

  "TorDisabled": true,
  "BraveVPNDisabled": 1,
  "BraveRewardsDisabled": true,
  "BraveWalletDisabled": true,

  "BackgroundModeEnabled": false
}
