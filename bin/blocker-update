#!/bin/bash
# blocker-adulte — mise a jour depuis le depot git
#
# Installe dans : /usr/sbin/blocker-update
#
# Recupere les modifications du depot, verifie qu'elles sont saines, puis
# reinstalle. L'emplacement du depot est memorise a l'installation dans
# /etc/blocker-adulte/source : plus besoin de se rappeler ou on l'avait clone.
#
# POURQUOI LA MISE A JOUR N'EST PAS AUTOMATIQUE
#
# Appliquer sans regarder du code venu d'internet, sur une machine ou il
# tournera en root, est une mauvaise idee — meme quand le depot est le sien.
# Un depot peut etre compromis, ou simplement contenir une modification qu'on
# n'a pas voulue. Ce script montre donc TOUJOURS ce qui va changer avant de
# l'appliquer, et demande confirmation.
#
# C'est aussi pour cela qu'aucun timer ne lance cette commande : la detection
# peut etre automatique, l'application reste un geste conscient.
#
# Usage :
#   blocker-update --verifier    regarde s'il y a du nouveau, n'installe rien
#   blocker-update               affiche les changements puis demande confirmation
#   blocker-update --oui         applique sans demander (pour un script)
#   blocker-update --source DIR  utilise ce depot et le memorise

set -uo pipefail

. /usr/lib/blocker-adulte/blocker-common.sh

blocker_require_root

FICHIER_SOURCE="${BLOCKER_CONFDIR}/source"
MODE="interactif"
SOURCE=""

while [ $# -gt 0 ]; do
    case "$1" in
        --verifier|--check) MODE="verifier" ;;
        --oui|--yes|-y)     MODE="auto" ;;
        --source)           SOURCE="${2:-}"; shift ;;
        -h|--help) sed -n '2,30p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *) echo "Argument inconnu / unknown argument : $1" >&2; exit 2 ;;
    esac
    shift
done

if [ -t 1 ]; then
    VERT=$'\033[32m'; ROUGE=$'\033[31m'; GRAS=$'\033[1m'; GRIS=$'\033[90m'; Z=$'\033[0m'
else
    VERT=""; ROUGE=""; GRAS=""; GRIS=""; Z=""
fi

# ---------------------------------------------------------------------------
# Localiser le depot
# ---------------------------------------------------------------------------
if [ -z "${SOURCE}" ] && [ -r "${FICHIER_SOURCE}" ]; then
    SOURCE="$(cat "${FICHIER_SOURCE}")"
fi

if [ -z "${SOURCE}" ]; then
    cat >&2 <<EOF
Emplacement du depot inconnu.

Il est normalement memorise a l'installation dans ${FICHIER_SOURCE}.
S'il manque — installation par paquet .deb, ou depot deplace depuis —
l'indiquer une fois, il sera retenu :

  sudo blocker-update --source /chemin/vers/safezone
EOF
    exit 1
fi

if [ ! -d "${SOURCE}/.git" ]; then
    blocker_err "${SOURCE} $(m "n'est pas un depot git" "is not a git repository")"
    blocker_err "$(m "indiquer le bon chemin" "give the right path") : sudo blocker-update --source /path/to/safezone"
    exit 1
fi

if ! command -v git >/dev/null 2>&1; then
    blocker_err "$(m "git est requis : installer le paquet" "git is required: install the package") git"
    exit 1
fi

# Le chemin fourni est memorise, comme le message d'aide le promet : sans cela
# il faudrait le redonner a chaque fois.
SOURCE="$(cd "${SOURCE}" && pwd)"
if [ ! -r "${FICHIER_SOURCE}" ] || [ "$(cat "${FICHIER_SOURCE}")" != "${SOURCE}" ]; then
    install -d -m 0755 "${BLOCKER_CONFDIR}"
    printf '%s\n' "${SOURCE}" > "${FICHIER_SOURCE}"
    chmod 0644 "${FICHIER_SOURCE}"
    blocker_info "$(m "depot memorise pour les prochaines fois" "repository remembered for next time") : ${SOURCE}"
fi

# git refuse de travailler dans un depot appartenant a un autre utilisateur —
# le cas normal ici, puisqu'on est root et que le clone appartient a l'humain.
git config --global --get-all safe.directory 2>/dev/null | grep -qxF "${SOURCE}" || \
    git config --global --add safe.directory "${SOURCE}" 2>/dev/null || true

cd "${SOURCE}" || { blocker_err "$(m "impossible d'entrer dans" "cannot enter") ${SOURCE}"; exit 1; }

# ---------------------------------------------------------------------------
# Y a-t-il du nouveau ?
# ---------------------------------------------------------------------------
printf '%s%s%s %s\n' "${GRAS}" "$(m "Depot :" "Repository:")" "${Z}" "${SOURCE}"

BRANCHE="$(git rev-parse --abbrev-ref HEAD 2>/dev/null)"
printf '%s%s%s %s\n\n' "${GRAS}" "$(m "Branche :" "Branch:")" "${Z}" "${BRANCHE}"

# Des modifications locales seraient ecrasees par la mise a jour : on prefere
# s'arreter plutot que de faire disparaitre le travail de quelqu'un.
if [ -n "$(git status --porcelain 2>/dev/null)" ]; then
    printf '%s%s%s\n' "${ROUGE}" "$(m "Modifications locales non validees :" "Uncommitted local changes:")" "${Z}"
    git status --short | sed 's/^/  /'
    printf '\n%s\n' "$(m "La mise a jour les ecraserait. Les valider ou les annuler d abord :" \
                            "The update would overwrite them. Commit or discard them first:")"
    printf '  cd %s && git stash      # %s\n' "${SOURCE}" "$(m "les mettre de cote" "set them aside")"
    printf '  cd %s && git checkout . # %s\n' "${SOURCE}" "$(m "les jeter" "throw them away")"
    exit 1
fi

blocker_info "$(m "recuperation des modifications distantes" "fetching remote changes")"
if ! git fetch --quiet origin "${BRANCHE}" 2>/dev/null; then
    blocker_err "$(m "git fetch a echoue (machine hors ligne ?)" "git fetch failed (machine offline?)")"
    exit 1
fi

LOCAL="$(git rev-parse HEAD)"
DISTANT="$(git rev-parse "origin/${BRANCHE}" 2>/dev/null || echo "${LOCAL}")"

if [ "${LOCAL}" = "${DISTANT}" ]; then
    printf '%s%s%s (%s)\n' "${VERT}" "$(m "Deja a jour" "Already up to date")" "${Z}" "${LOCAL:0:8}"
    exit 0
fi

# Quatre situations, pas deux. Sans cette distinction, un depot local EN AVANCE
# sur le distant affichait le diff a l'envers — « 222 suppressions » — et le
# merge --ff-only echouait ensuite sans explication utile.
if git merge-base --is-ancestor "${DISTANT}" "${LOCAL}" 2>/dev/null; then
    NB_AVANCE="$(git rev-list --count "${DISTANT}..${LOCAL}" 2>/dev/null || echo '?')"
    printf '%sDepot local en avance de %s commit(s) sur origin/%s.%s\n' \
        "${VERT}" "${NB_AVANCE}" "${BRANCHE}" "${Z}"
    printf '%s\n' "$(m "Rien a recuperer. Pour publier vos modifications :" \
                          "Nothing to fetch. To publish your changes:")"
    printf '  cd %s && git push\n' "${SOURCE}"
    exit 0
fi

if ! git merge-base --is-ancestor "${LOCAL}" "${DISTANT}" 2>/dev/null; then
    printf '%sHistoriques divergents%s : le depot local et origin/%s ont chacun\n' \
        "${ROUGE}" "${Z}" "${BRANCHE}"
    printf '%s\n' "$(m "des commits que l autre n a pas. La mise a jour automatique s arrete ici :" \
                          "commits the other does not have. The automatic update stops here:")"
    printf '%s\n\n' "$(m "fusionner a l aveugle risquerait de perdre du travail." \
                           "merging blindly could lose work.")"
    printf '  cd %s && git log --oneline --graph --all -20\n' "${SOURCE}"
    exit 1
fi

NB="$(git rev-list --count "${LOCAL}..${DISTANT}" 2>/dev/null || echo '?')"
printf '%s%s nouveau(x) commit(s)%s : %s -> %s\n\n' \
    "${GRAS}" "${NB}" "${Z}" "${LOCAL:0:8}" "${DISTANT:0:8}"

git log --oneline --no-decorate "${LOCAL}..${DISTANT}" 2>/dev/null | head -20 | sed 's/^/  /'
printf '\n%sFichiers modifies :%s\n' "${GRAS}" "${Z}"
git diff --stat "${LOCAL}..${DISTANT}" 2>/dev/null | tail -20 | sed 's/^/  /'

if [ "${MODE}" = "verifier" ]; then
    printf '\n%s\n' "$(m "Mode verification : rien n a ete installe." "Check mode: nothing was installed.")"
    printf '%s : sudo blocker-update\n' "$(m "Pour appliquer" "To apply")"
    exit 0
fi

# ---------------------------------------------------------------------------
# Confirmation
# ---------------------------------------------------------------------------
if [ "${MODE}" = "interactif" ]; then
    printf '\n%s%s%s\n' "${GRAS}" \
        "$(m "Ces modifications vont s executer en root sur cette machine." \
             "These changes will run as root on this machine.")" "${Z}"
    printf '%s [%s] ' "$(m "Les avez-vous relues ? Appliquer la mise a jour ?" \
                            "Have you reviewed them? Apply the update?")" "$(m "o/N" "y/N")"
    read -r reponse </dev/tty || reponse=""
    case "${reponse}" in
        o|O|oui|y|Y|yes) ;;
        *) printf '%s\n' "$(m "Annule. Rien n a ete modifie." "Cancelled. Nothing was changed.")"; exit 0 ;;
    esac
fi

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
printf '\n%s=== %s ===%s\n' "${GRAS}" "$(m "Mise a jour" "Update")" "${Z}"

if ! git merge --ff-only "origin/${BRANCHE}" 2>&1 | sed 's/^/  /'; then
    blocker_err "$(m "la mise a jour n est pas une avance rapide — historique divergent" \
                     "the update is not a fast-forward — diverged history")"
    blocker_err "$(m "regler a la main" "sort it out by hand") : cd ${SOURCE} && git status"
    exit 1
fi

# On refuse d'installer du code qui ne passe pas ses propres controles : une
# erreur de syntaxe dans un watchdog laisserait la machine sans protection.
blocker_info "$(m "verification du code recupere (make check)" "checking the fetched code (make check)")"
if ! make -C "${SOURCE}" check 2>&1 | tail -5 | sed 's/^/  /'; then
    blocker_err "$(m "le code recupere ne passe pas « make check », installation abandonnee" \
                     "the fetched code fails « make check », install aborted")"
    blocker_err "$(m "le systeme reste sur la version precedente, toujours fonctionnelle" \
                     "the system stays on the previous version, still working")"
    blocker_err "$(m "revenir en arriere" "roll back") : cd ${SOURCE} && git reset --hard ${LOCAL}"
    exit 1
fi

# Le controle d'integrite du code se suspend le temps de l'installation : sans
# cela, la garde pourrait remettre l'ancien code entre « make install » et la
# configuration, qui enregistre le nouveau.
blocker_ensure_rundir
date -Is > "${BLOCKER_MAJ_FLAG}"
blocker_historique "mise a jour du code : ${LOCAL:0:8} -> ${DISTANT:0:8}" "blocker-update"
blocker_notifier "$(m "mise a jour du code de l'outil" "tool code update") : ${LOCAL:0:8} -> ${DISTANT:0:8}"

blocker_info "$(m "installation des fichiers" "installing the files")"
if ! make -C "${SOURCE}" install DESTDIR=/ >/dev/null 2>&1; then
    blocker_err "$(m "« make install » a echoue" "« make install » failed")"
    exit 1
fi

blocker_info "$(m "reconfiguration" "reconfiguring")"
/usr/lib/blocker-adulte/blocker-configure || \
    blocker_warn "$(m "blocker-configure a signale une erreur, voir ci-dessus" \
                      "blocker-configure reported an error, see above")"

# La mise a jour peut avoir change les modeles de configuration : on force une
# passe de self-heal plutot que d'attendre le prochain creneau de cinq minutes.
if [ -x /usr/lib/blocker-adulte/blocker-selfheal ]; then
    /usr/lib/blocker-adulte/blocker-selfheal >/dev/null 2>&1 || true
fi

printf '\n%s%s%s : %s -> %s\n' "${VERT}" "$(m "Mise a jour terminee" "Update finished")" "${Z}" \
    "${LOCAL:0:8}" "${DISTANT:0:8}"
printf '\n%s\n' "$(m "Verifier que tout va bien :" "Check that everything is fine:")"
printf '  sudo blocker-status\n'
printf '  sudo %s/tests/run_all.sh\n' "${SOURCE}"
printf '\n%s%s%s\n' "${GRIS}" "$(m "En cas de probleme, revenir en arriere :" \
                                       "If something goes wrong, roll back:")" "${Z}"
printf '  %scd %s && git reset --hard %s && sudo ./install.sh%s\n' \
    "${GRIS}" "${SOURCE}" "${LOCAL:0:8}" "${Z}"

exit 0
