#!/bin/bash
# blocker-adulte — configuration post-installation, idempotente
#
# Installe dans : /usr/lib/blocker-adulte/blocker-configure
#
# Point d'entree unique appele par install.sh ET par le postinst du paquet .deb,
# pour que les deux voies d'installation produisent exactement le meme etat.
#
# Chaque etape est independante et rejouable : relancer ce script sur un systeme
# deja configure ne change rien et ne casse rien.

set -uo pipefail

. /usr/lib/blocker-adulte/blocker-common.sh

blocker_require_root

step() { blocker_info "== $* =="; }

# ---------------------------------------------------------------------------
# 0. Utilisateur systeme
# ---------------------------------------------------------------------------
step "$(m "utilisateur systeme" "system user") ${BLOCKER_USER}"
if ! getent passwd "${BLOCKER_USER}" >/dev/null 2>&1; then
    # « adduser » est un script Debian ; blocker_user_creer passe par useradd,
    # qui vient de shadow-utils et existe sur toutes les distributions.
    if blocker_user_creer "${BLOCKER_USER}"; then
        blocker_info "$(m "utilisateur systeme" "system user") ${BLOCKER_USER} $(m "cree" "created")"
    else
        blocker_err "$(m "creation de l'utilisateur" "cannot create user") ${BLOCKER_USER} $(m "impossible (useradd absent ?)" "(useradd missing?)")"
        blocker_err "$(m "le resolveur ne pourra pas abandonner ses privileges : arret." \
                 "the resolver could not drop its privileges: aborting.")"
        exit 1
    fi
fi

install -d -m 0755 "${BLOCKER_STATEDIR}" "${BLOCKER_STATEDIR}/conf" "${BLOCKER_NFTDIR}" \
                   "${BLOCKER_DELAIDIR}" "${BLOCKER_RAPPORTDIR}" "${BLOCKER_CONFDIR}"
blocker_unlock_dir "${BLOCKER_LISTDIR}"
install -d -m 0755 "${BLOCKER_LISTDIR}"
install -d -m 0755 -o "${BLOCKER_USER}" -g "${BLOCKER_USER}" "${BLOCKER_RUNDIR}"

# Le drapeau de retrait volontaire ne doit pas survivre a une reinstallation.
rm -f "${BLOCKER_OPTOUT_FLAG}"

# Configuration locale : posee une seule fois, jamais ecrasee ensuite, pour ne
# pas perdre les reglages de l'utilisateur a chaque mise a jour.
if [ ! -e "${BLOCKER_CONF}" ]; then
    install -m 0644 "${BLOCKER_SHAREDIR}/conf/blocker.conf" "${BLOCKER_CONF}"
    blocker_info "$(m "configuration locale installee" "local configuration installed") : ${BLOCKER_CONF}"
fi

# ---------------------------------------------------------------------------
# 0 bis. Configuration en vigueur et fichiers d'etat
# ---------------------------------------------------------------------------
# A la premiere installation (ou a la premiere mise a jour vers une version
# avec delai), le fichier de /etc est approuve tel quel et les fichiers d'etat
# deja en place sont adoptes. Ensuite, une reinstallation ne reapprouve RIEN :
# blocker-update ne doit pas devenir un raccourci autour du delai.
step "$(m "configuration en vigueur" "configuration in force")"
blocker_adopter_etat
# La configuration en vigueur vient peut-etre d'etre posee : on la relit.
# shellcheck disable=SC1090
[ -r "${BLOCKER_CONF_EN_VIGUEUR}" ] && . "${BLOCKER_CONF_EN_VIGUEUR}"

# ---------------------------------------------------------------------------
# 1. Liste de blocage de base et categories
# ---------------------------------------------------------------------------
step "$(m "liste de blocage" "blocklist")"
blocker_publier "${BLOCKER_SHAREDIR}/blocklists/00-base.conf" \
                "${BLOCKER_LISTDIR}/00-base.conf" && \
    blocker_info "$(m "liste de blocage de base en place (fonctionne hors ligne)" \
                      "base blocklist in place (works offline)")"
/usr/lib/blocker-adulte/blocker-categories
case "$?" in
    0|3) ;;
    *) blocker_warn "$(m "generation des categories en echec" "generating the categories failed")" ;;
esac

# ---------------------------------------------------------------------------
# 1 bis. Resolveurs amont, generes depuis blocker.conf
# ---------------------------------------------------------------------------
step "$(m "resolveurs amont" "upstream resolvers")"
/usr/lib/blocker-adulte/blocker-upstream || \
    blocker_err "$(m "generation des resolveurs amont en echec" "generating the upstream resolvers failed")"

# ---------------------------------------------------------------------------
# 2. Fichiers de configuration proteges
# ---------------------------------------------------------------------------
step "$(m "fichiers de configuration" "configuration files")"
blocker_install_protected "${BLOCKER_SHAREDIR}/conf/dnsmasq-blocker-adulte.conf" \
                          "/etc/dnsmasq.d/blocker-adulte.conf"
blocker_install_protected "${BLOCKER_SHAREDIR}/conf/nftables-blocker-adulte.nft" \
                          "/etc/nftables/blocker-adulte.nft"
blocker_install_protected "${BLOCKER_SHAREDIR}/conf/nftables-blocker-adulte-tunnels.nft" \
                          "/etc/nftables/blocker-adulte-tunnels.nft"
blocker_install_protected "${BLOCKER_SHAREDIR}/conf/resolved-blocker-adulte.conf" \
                          "/etc/systemd/resolved.conf.d/blocker-adulte.conf"
blocker_install_protected "${BLOCKER_SHAREDIR}/conf/90-blocker-adulte" \
                          "/etc/NetworkManager/dispatcher.d/90-blocker-adulte" 0755

# ---------------------------------------------------------------------------
# 3. Inclusion dans /etc/nftables.conf (persistance au boot)
# ---------------------------------------------------------------------------
step "$(m "persistance nftables" "nftables persistence")"
# Debian et Arch chargent /etc/nftables.conf, Fedora et RHEL
# /etc/sysconfig/nftables.conf. blocker_nft_persist_file lit la ligne ExecStart
# de nftables.service plutot que de trancher a notre place.
NFT_MAIN="$(blocker_nft_persist_file)"
NFT_INCLUDE='include "/etc/nftables/blocker-adulte.nft"'
blocker_info "$(m "fichier de persistance nftables" "nftables persistence file") : ${NFT_MAIN}"
install -d -m 0755 "$(dirname "${NFT_MAIN}")"

if [ ! -e "${NFT_MAIN}" ]; then
    cat > "${NFT_MAIN}" <<'EOF'
#!/usr/sbin/nft -f
# Fichier cree par blocker-adulte (install.sh). Il ne contient volontairement
# pas de « flush ruleset » afin de ne pas effacer d'autres regles de pare-feu.
EOF
    chmod 0755 "${NFT_MAIN}"
    blocker_info "${NFT_MAIN} $(m "cree" "created")"
fi

if ! grep -qF 'blocker-adulte.nft' "${NFT_MAIN}"; then
    printf '\n# blocker-adulte (composant 2) — retirer cette ligne lors de la desinstallation\n%s\n' \
        "${NFT_INCLUDE}" >> "${NFT_MAIN}"
    blocker_info "$(m "ligne d'inclusion ajoutee a" "include line added to") ${NFT_MAIN}"
fi

# ---------------------------------------------------------------------------
# 4. Policies navigateur
# ---------------------------------------------------------------------------
step "$(m "policies navigateur" "browser policies")"
/usr/lib/blocker-adulte/blocker-apply-policies || \
    blocker_warn "$(m "deploiement des policies partiellement en echec" "browser policy deployment partly failed")"

# ---------------------------------------------------------------------------
# 5. Regles auditd
# ---------------------------------------------------------------------------
step "$(m "regles auditd" "auditd rules")"
if [ -d /etc/audit/rules.d ]; then
    # Les lignes visant un chemin absent sont mises en commentaire : sans cela
    # « auditctl -R » s'arreterait sur la premiere et ignorerait les suivantes.
    blocker_regles_audit > /etc/audit/rules.d/blocker-adulte.rules
    chmod 0640 /etc/audit/rules.d/blocker-adulte.rules
    if command -v augenrules >/dev/null 2>&1; then
        augenrules --load >/dev/null 2>&1 || \
            blocker_warn "$(m "augenrules --load a echoue (auditd est-il demarre ?)" "augenrules --load failed (is auditd running?)")"
    fi
    blocker_info "$(m "regles auditd installees dans" "auditd rules installed in") /etc/audit/rules.d/blocker-adulte.rules"
else
    blocker_warn "$(m "auditd absent : composant 8 inactif. Installer le paquet" \
                  "auditd missing: component 8 inactive. Install the package") $(blocker_pkg_pour_role auditd)"
fi

# ---------------------------------------------------------------------------
# 6. Hook initramfs
# ---------------------------------------------------------------------------
step "$(m "hook initramfs" "initramfs hook") (${BLOCKER_INITRAMFS})"
INITRAMFS_POSE=0

case "${BLOCKER_INITRAMFS}" in
    initramfs-tools)
        install -d -m 0755 /etc/initramfs-tools/hooks \
                           /etc/initramfs-tools/scripts/init-bottom
        install -m 0755 "${BLOCKER_SHAREDIR}/initramfs/blocker-adulte-hook" \
                        /etc/initramfs-tools/hooks/blocker-adulte
        install -m 0755 "${BLOCKER_SHAREDIR}/initramfs/blocker-adulte-init-bottom" \
                        /etc/initramfs-tools/scripts/init-bottom/blocker-adulte
        INITRAMFS_POSE=1
        ;;

    dracut)
        # Un module dracut est un simple repertoire depose : rien d'autre a
        # configurer, dracut le decouvre seul et son check() decide de
        # l'inclure. Aucun fichier appartenant a une autre paquet n'est touche.
        DRACUT_MOD=/usr/lib/dracut/modules.d/99blocker-adulte
        install -d -m 0755 "${DRACUT_MOD}"
        install -m 0755 "${BLOCKER_SHAREDIR}/initramfs/dracut-module-setup.sh" \
                        "${DRACUT_MOD}/module-setup.sh"
        install -m 0755 "${BLOCKER_SHAREDIR}/initramfs/dracut-blocker-adulte-prepivot.sh" \
                        "${DRACUT_MOD}/blocker-adulte-prepivot.sh"
        INITRAMFS_POSE=1
        ;;

    mkinitcpio)
        install -d -m 0755 /etc/initcpio/install /etc/initcpio/hooks
        install -m 0755 "${BLOCKER_SHAREDIR}/initramfs/mkinitcpio-blocker-adulte-install" \
                        /etc/initcpio/install/blocker-adulte
        install -m 0755 "${BLOCKER_SHAREDIR}/initramfs/mkinitcpio-blocker-adulte-hook" \
                        /etc/initcpio/hooks/blocker-adulte

        # mkinitcpio n'execute que les hooks listes dans HOOKS : deposer les
        # fichiers ne suffit pas. Mais une ligne HOOKS erronee empeche la
        # machine de demarrer — on ne modifie donc ce fichier que si
        # l'utilisateur l'a demande, et on revient en arriere si la
        # reconstruction echoue.
        MKCONF=/etc/mkinitcpio.conf
        if grep -qE '^HOOKS=.*\bblocker-adulte\b' "${MKCONF}" 2>/dev/null; then
            INITRAMFS_POSE=1
        elif [ "${BLOCKER_MKINITCPIO_HOOK:-non}" = "oui" ] && [ -w "${MKCONF}" ]; then
            cp -a "${MKCONF}" "${MKCONF}.avant-blocker-adulte"
            sed -i -E 's/^(HOOKS=\(.*)\)[[:space:]]*$/\1 blocker-adulte)/' "${MKCONF}"
            if grep -qE '^HOOKS=.*\bblocker-adulte\b' "${MKCONF}"; then
                blocker_info "$(m "hook ajoute a HOOKS dans" "hook added to HOOKS in") ${MKCONF} ($(m "sauvegarde" "backup") : ${MKCONF}.avant-blocker-adulte)"
                if mkinitcpio -P >/dev/null 2>&1; then
                    INITRAMFS_POSE=1
                else
                    cp -a "${MKCONF}.avant-blocker-adulte" "${MKCONF}"
                    mkinitcpio -P >/dev/null 2>&1 || true
                    blocker_err "$(m "mkinitcpio -P a echoue" "mkinitcpio -P failed") : ${MKCONF} $(m "restaure, composant 4 inactif" "restored, component 4 inactive")"
                fi
            else
                cp -a "${MKCONF}.avant-blocker-adulte" "${MKCONF}"
                blocker_warn "$(m "ligne HOOKS non reconnue dans" "HOOKS line not recognised in") ${MKCONF}, $(m "fichier restaure tel quel" "file restored unchanged")"
            fi
        else
            blocker_warn "$(m "composant 4 en attente : ajouter « blocker-adulte » a HOOKS dans" \
                  "component 4 pending: add « blocker-adulte » to HOOKS in") ${MKCONF},"
            blocker_warn "$(m "puis « sudo mkinitcpio -P ». Automatisable par" \
                  "then « sudo mkinitcpio -P ». Can be automated with") BLOCKER_MKINITCPIO_HOOK=\"oui\"."
        fi
        ;;

    *)
        blocker_warn "$(m "aucun generateur d'initramfs reconnu : composant 4 inactif" \
                  "no initramfs generator recognised: component 4 inactive")"
        blocker_warn "$(m "supportes" "supported") : initramfs-tools, dracut, mkinitcpio"
        ;;
esac

# La reconstruction de l'image a deja eu lieu pour mkinitcpio (elle fait partie
# de la validation du retour arriere) : on ne la refait pas.
if [ "${INITRAMFS_POSE}" -eq 1 ] && [ "${BLOCKER_INITRAMFS}" != "mkinitcpio" ]; then
    blocker_info "$(m "regeneration de l'initramfs" "rebuilding the initramfs") (${BLOCKER_INITRAMFS})"
    blocker_initramfs_rebuild >/dev/null 2>&1 || \
        blocker_warn "$(m "la regeneration de l'initramfs a echoue ; la relancer a la main" \
                  "rebuilding the initramfs failed; run it again by hand")"
fi

# ---------------------------------------------------------------------------
# 7. systemd-resolved
# ---------------------------------------------------------------------------
step "systemd-resolved"
if systemctl list-unit-files systemd-resolved.service >/dev/null 2>&1; then
    systemctl enable --now systemd-resolved.service >/dev/null 2>&1 || true
    systemctl restart systemd-resolved.service || \
        blocker_warn "$(m "redemarrage de systemd-resolved en echec" "restarting systemd-resolved failed")"
fi

# ---------------------------------------------------------------------------
# 8. Unites systemd du projet
# ---------------------------------------------------------------------------
step "$(m "unites systemd" "systemd units")"
systemctl daemon-reload

# nftables.service assure le chargement au boot, tot dans la sequence.
if systemctl list-unit-files nftables.service >/dev/null 2>&1; then
    systemctl enable nftables.service >/dev/null 2>&1 || true
fi

# Ordre volontaire : le resolveur d'abord, la garde ensuite.
systemctl enable --now blocker-resolver.service || \
    blocker_err "$(m "blocker-resolver.service n'a pas demarre" "blocker-resolver.service did not start") — journalctl -u blocker-resolver"
systemctl enable --now blocker-guard.service || \
    blocker_err "$(m "blocker-guard.service n'a pas demarre" "blocker-guard.service did not start") — journalctl -u blocker-guard"
systemctl enable --now blocker-selfheal.timer || \
    blocker_warn "blocker-selfheal.timer $(m "non arme" "not armed")"
systemctl enable --now blocker-list-update.timer || \
    blocker_warn "blocker-list-update.timer $(m "non arme" "not armed")"
systemctl enable --now blocker-rapport.timer || \
    blocker_warn "blocker-rapport.timer $(m "non arme" "not armed")"

# Composant 5, volet portable : surveillance directe des repertoires de
# policies. Elle couvre les navigateurs installes par snap ou flatpak, que le
# gestionnaire de paquets ne voit pas, et toutes les distributions ou aucun
# hook de paquet n'existe.
systemctl enable --now blocker-policies.path || \
    blocker_warn "blocker-policies.path $(m "non arme : la reapplication des policies attendra le self-heal" "not armed: policy reapplication will wait for self-heal")"

# Hook du gestionnaire de paquets, la ou il en existe un par simple depot de
# fichier (pacman). dpkg passe par les triggers du paquet .deb.
PKG_HOOK="$(blocker_pkg_hook_path)"
if [ -n "${PKG_HOOK}" ]; then
    install -d -m 0755 "$(dirname "${PKG_HOOK}")"
    install -m 0644 "${BLOCKER_SHAREDIR}/conf/pacman-95-blocker-adulte.hook" "${PKG_HOOK}"
    blocker_info "$(m "hook du gestionnaire de paquets installe" "package-manager hook installed") : ${PKG_HOOK}"
fi

# ---------------------------------------------------------------------------
# 9. Regles nftables et immuabilite
# ---------------------------------------------------------------------------
step "$(m "regles nftables" "nftables rules")"
/usr/lib/blocker-adulte/blocker-apply-nftables --force || \
    blocker_err "$(m "chargement des regles nftables en echec" "loading the nftables rules failed")"

step "$(m "immuabilite des fichiers proteges" "immutability of the protected files")"
blocker_lock_all
blocker_lock_dir "${BLOCKER_LISTDIR}"

if [ -z "${BLOCKER_RAPPORT_DESTINATAIRE:-}" ]; then
    blocker_warn "$(m "aucune personne de confiance ne recoit le rapport hebdomadaire :" \
                      "no trusted person receives the weekly report:")"
    blocker_warn "  $(m "renseigner BLOCKER_RAPPORT_DESTINATAIRE dans" "set BLOCKER_RAPPORT_DESTINATAIRE in") ${BLOCKER_CONF}"
fi

blocker_info "$(m "configuration terminee. Etat" "configuration finished. Status") : blocker-status"
blocker_info "$(m "ce qui affaiblit la protection attend" "whatever weakens the protection waits") ${BLOCKER_DELAI_HEURES} h : blocker-delai"
exit 0
