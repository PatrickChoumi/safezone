#!/bin/bash
# blocker-adulte — passe de self-heal (composant 7)
#
# Installe dans : /usr/lib/blocker-adulte/blocker-selfheal
# Lance par     : blocker-selfheal.timer (toutes les 5 minutes)
#
# Contrairement a blocker-guard, ce script ne tourne pas en boucle : il fait une
# passe complete puis se termine. C'est la redondance du composant 6 — si les
# deux services sont arretes en meme temps, le timer les remet en route.
#
# Il journalise systematiquement un compte-rendu, meme quand rien n'a bouge, et
# journalise separement chaque ecart corrige (« REPARATION: ... »).

set -uo pipefail

. /usr/lib/blocker-adulte/blocker-common.sh

blocker_require_root
blocker_ensure_rundir

if blocker_stand_down_if_optout; then
    exit 0
fi

ecarts=0
note() { ecarts=$((ecarts + 1)); blocker_repair "$*"; }

# L'abstention sur /etc/hosts ne doit pas etre silencieuse : c'est le
# contournement le plus simple de tout l'outil, l'utilisateur doit savoir si ce
# trou est ouvert ou ferme sur sa machine.
if blocker_hosts_verrouillable; then
    blocker_info "/etc/hosts : $(m "verrouille (immuable)" "locked (immutable)")"
else
    blocker_warn "/etc/hosts : $(m "NON verrouille — une ligne y suffit a contourner le resolveur" \
                              "NOT locked — a single line there bypasses the resolver")"
    blocker_warn "  $(m "raison" "reason") : BLOCKER_LOCK_HOSTS=${BLOCKER_LOCK_HOSTS:-auto} $(m "et/ou Docker/podman/LXC/cloud-init detecte" "and/or Docker/podman/LXC/cloud-init detected")"
    blocker_warn "  $(m "les modifications restent tracees par auditd" "changes are still traced by auditd") (ausearch -k blocker-adulte)"
fi

# ---------------------------------------------------------------------------
# 1. Immuabilite des fichiers proteges
# ---------------------------------------------------------------------------
# blocker_lock_file journalise lui-meme chaque « chattr +i » reapplique.
avant="$(mktemp)"; apres="$(mktemp)"
trap 'rm -f "${avant}" "${apres}"' EXIT

while IFS= read -r f; do
    [ -e "$f" ] || continue
    lsattr -d "$f" 2>/dev/null | awk '{print $1}' >> "${avant}"
done < <(blocker_protected_files)

blocker_lock_all

while IFS= read -r f; do
    [ -e "$f" ] || continue
    lsattr -d "$f" 2>/dev/null | awk '{print $1}' >> "${apres}"
done < <(blocker_protected_files)

if ! cmp -s "${avant}" "${apres}"; then
    ecarts=$((ecarts + 1))
fi

# ---------------------------------------------------------------------------
# 2. Fichiers de configuration manquants ou modifies
# ---------------------------------------------------------------------------
verifier_fichier() {
    local modele="$1" cible="$2" mode="${3:-0644}"
    [ -r "${modele}" ] || return 0
    if [ ! -e "${cible}" ]; then
        note "$(m "fichier absent, reinstalle" "file missing, reinstalled") : ${cible}"
        blocker_install_protected "${modele}" "${cible}" "${mode}"
        return 0
    fi
    if ! cmp -s "${modele}" "${cible}"; then
        note "$(m "fichier modifie, restaure depuis le modele" "file modified, restored from template") : ${cible}"
        blocker_install_protected "${modele}" "${cible}" "${mode}"
    fi
}

verifier_fichier "${BLOCKER_SHAREDIR}/conf/dnsmasq-blocker-adulte.conf" \
                 "/etc/dnsmasq.d/blocker-adulte.conf"
verifier_fichier "${BLOCKER_SHAREDIR}/conf/nftables-blocker-adulte.nft" \
                 "/etc/nftables/blocker-adulte.nft"
verifier_fichier "${BLOCKER_SHAREDIR}/conf/nftables-blocker-adulte-tunnels.nft" \
                 "/etc/nftables/blocker-adulte-tunnels.nft"
verifier_fichier "${BLOCKER_SHAREDIR}/conf/resolved-blocker-adulte.conf" \
                 "/etc/systemd/resolved.conf.d/blocker-adulte.conf"
verifier_fichier "${BLOCKER_SHAREDIR}/conf/90-blocker-adulte" \
                 "/etc/NetworkManager/dispatcher.d/90-blocker-adulte" 0755

# ---------------------------------------------------------------------------
# 3. Les quatre familles de policies navigateur
# ---------------------------------------------------------------------------
policies_avant=0
while IFS='|' read -r dir filename _f; do
    [ -n "${dir}" ] || continue
    [ -s "${dir}/${filename}" ] && policies_avant=$((policies_avant + 1))
done < <(blocker_browser_targets)

/usr/lib/blocker-adulte/blocker-apply-policies >/dev/null 2>&1 || \
    blocker_warn "$(m "blocker-apply-policies a signale une erreur" "blocker-apply-policies reported an error")"

policies_apres=0
while IFS='|' read -r dir filename _f; do
    [ -n "${dir}" ] || continue
    [ -s "${dir}/${filename}" ] && policies_apres=$((policies_apres + 1))
done < <(blocker_browser_targets)

if [ "${policies_apres}" -gt "${policies_avant}" ]; then
    note "$(m "policies navigateur redeployees" "browser policies redeployed") (${policies_avant} -> ${policies_apres})"
fi

# ---------------------------------------------------------------------------
# 3 quater. Listes livrees avec le paquet
# ---------------------------------------------------------------------------
# Supprimer un fichier de /var/lib est le contournement le moins couteux qui
# existe : pas de droit particulier a obtenir au-dela de root, rien a
# reconfigurer, et le resolveur redemarre sans se plaindre. On repose donc ce
# que le paquet fournit des qu'il manque.
#
# 50-perso.conf et 51-motifs.conf n'apparaissent pas ici : ils appartiennent a
# l'utilisateur, qui a le droit de les vider.
reposees=0
for livree in 00-base.conf 02-plateformes.conf 03-nsfw.conf; do
    modele="${BLOCKER_SHAREDIR}/blocklists/${livree}"
    pose="${BLOCKER_STATEDIR}/blocklists/${livree}"
    [ -e "${modele}" ] || continue
    [ -s "${pose}" ] && continue
    if install -m 0644 "${modele}" "${pose}" 2>/dev/null; then
        note "$(m "liste livree absente, reposee" "shipped list missing, reinstalled") : ${livree}"
        reposees=$((reposees + 1))
    fi
done
# Les categories activees et les motifs : une categorie active dont le fichier
# a disparu de /var/lib serait desactivee en silence. L'etat fait foi, pas la
# presence du fichier.
manquantes=0
if [ -s "${BLOCKER_STATEDIR}/categories-actives" ]; then
    while IFS= read -r nom; do
        case "${nom}" in ''|'#'*) continue ;; esac
        [ -s "${BLOCKER_STATEDIR}/blocklists/40-cat-${nom}.conf" ] || manquantes=1
    done < "${BLOCKER_STATEDIR}/categories-actives"
fi
if [ -s "${BLOCKER_STATEDIR}/motifs" ] && \
   [ ! -s "${BLOCKER_STATEDIR}/blocklists/51-motifs.conf" ]; then
    manquantes=1
fi
if [ "${manquantes}" -eq 1 ] && [ -x /usr/sbin/blocker-block ]; then
    note "$(m "motifs ou categories absents, regeneration" \
           "patterns or categories missing, regenerating")"
    /usr/sbin/blocker-block --regenerer >/dev/null 2>&1 || true
    reposees=$((reposees + 1))
fi

# Un seul redemarrage, quel que soit le nombre de listes reposees : chacun
# coupe le DNS une fraction de seconde, et deux d'affilee n'apportent rien.
if [ "${reposees}" -gt 0 ]; then
    systemctl restart blocker-resolver.service 2>/dev/null || true
fi

# ---------------------------------------------------------------------------
# 3 ter. Resolveurs amont conformes a blocker.conf
# ---------------------------------------------------------------------------
# Sans amont, dnsmasq ne resout plus rien : la machine parait privee de reseau.
UP="${BLOCKER_STATEDIR}/blocklists/01-upstream.conf"
if [ ! -s "${UP}" ]; then
    note "$(m "fichier d amont absent, regeneration" "upstream file missing, regenerating")"
    /usr/lib/blocker-adulte/blocker-upstream >/dev/null 2>&1 && \
        systemctl restart blocker-resolver.service 2>/dev/null || true
elif ! grep -q "^server=${BLOCKER_UPSTREAM_1}\$" "${UP}" 2>/dev/null; then
    note "$(m "amont du fichier different de blocker.conf, regeneration" \
           "file upstream differs from blocker.conf, regenerating")"
    /usr/lib/blocker-adulte/blocker-upstream >/dev/null 2>&1 && \
        systemctl restart blocker-resolver.service 2>/dev/null || true
fi

# ---------------------------------------------------------------------------
# 3 bis. Derive des adresses SafeSearch
# ---------------------------------------------------------------------------
# Ce controle protege contre une panne, pas contre un contournement.
#
# Les adresses des hotes « stricts » appartiennent aux moteurs et peuvent
# changer sans preavis. Si l'adresse de forcesafesearch.google.com change, notre
# fichier continue de faire pointer www.google.com vers l'ancienne : Google
# devient injoignable pour toute la machine, jusqu'a la mise a jour quotidienne.
#
# Une panne de Google Search est exactement le genre d'incident qui fait tout
# desinstaller. On verifie donc la derive plus souvent que la mise a jour des
# listes — mais pas a chaque passe : une requete DNS toutes les 5 minutes pour
# rien serait du gaspillage. On ne sonde que si le fichier a plus de 6 heures.
SS="${BLOCKER_STATEDIR}/blocklists/05-safesearch.conf"

safesearch_actif() {
    case "${BLOCKER_SAFESEARCH:-oui}" in
        non|no|0) return 1 ;;
    esac
    return 0
}

if safesearch_actif; then
    if [ ! -s "${SS}" ]; then
        note "$(m "SafeSearch absent, regeneration" "SafeSearch missing, regenerating")"
        /usr/lib/blocker-adulte/blocker-safesearch >/dev/null 2>&1 && \
            systemctl restart blocker-resolver.service 2>/dev/null || true
    else
        age_h=$(( ( $(date +%s) - $(stat -c %Y "${SS}" 2>/dev/null || date +%s) ) / 3600 ))
        if [ "${age_h}" -ge 6 ] && command -v dig >/dev/null 2>&1; then
            # Sonde temoin : un seul hote suffit a detecter une derive, et
            # Google est celui dont une panne se verrait le plus.
            temoin="forcesafesearch.google.com"
            reel="$(runuser -u "${BLOCKER_USER}" -- \
                    dig +short +time=4 +tries=1 -tA "@${BLOCKER_UPSTREAM_1}" "${temoin}" \
                    2>/dev/null | grep -E '^[0-9.]+$' | sort -u | head -1)"
            enregistre="$(grep '^address=/www\.google\.com/' "${SS}" 2>/dev/null \
                          | sed 's|.*/||' | grep -E '^[0-9.]+$' | sort -u | head -1)"

            if [ -n "${reel}" ] && [ -n "${enregistre}" ] && [ "${reel}" != "${enregistre}" ]; then
                note "$(m "adresse SafeSearch perimee" "stale SafeSearch address") (${enregistre} -> ${reel}), $(m "regeneration immediate" "regenerating now")"
                note "$(m "sans cette correction, www.google.com pointerait vers une adresse morte" \
           "without this fix, www.google.com would point at a dead address")"
                if /usr/lib/blocker-adulte/blocker-safesearch >/dev/null 2>&1; then
                    systemctl restart blocker-resolver.service 2>/dev/null || true
                    blocker_info "$(m "SafeSearch regenere et resolveur redemarre" "SafeSearch regenerated and resolver restarted")"
                else
                    blocker_err "$(m "regeneration du SafeSearch en echec" "regenerating SafeSearch failed")"
                fi
            fi
        fi
    fi
fi

# ---------------------------------------------------------------------------
# 4. Regles nftables actives vs attendues
# ---------------------------------------------------------------------------
if ! /usr/lib/blocker-adulte/blocker-apply-nftables --check >/dev/null 2>&1; then
    note "$(m "regles nftables non conformes, rechargement" "nftables rules non-compliant, reloading")"
    /usr/lib/blocker-adulte/blocker-apply-nftables --force >/dev/null 2>&1 || \
        blocker_err "$(m "rechargement nftables en echec" "reloading nftables failed")"
fi

# Ligne d'inclusion dans le fichier charge par nftables.service (persistance au
# boot). Ce fichier n'est pas au meme endroit partout : /etc/nftables.conf sur
# Debian, Arch et openSUSE, /etc/sysconfig/nftables.conf sur Fedora et RHEL.
NFT_PERSIST="$(blocker_nft_persist_file)"
if [ -e "${NFT_PERSIST}" ] && ! grep -qF 'blocker-adulte.nft' "${NFT_PERSIST}"; then
    note "$(m "ligne d'inclusion absente de" "include line missing from") ${NFT_PERSIST}, $(m "reajoutee" "re-added")"
    printf '\n# blocker-adulte (composant 2)\ninclude "/etc/nftables/blocker-adulte.nft"\n' \
        >> "${NFT_PERSIST}"
fi

# ---------------------------------------------------------------------------
# 5. Les deux services de surveillance croisee
# ---------------------------------------------------------------------------
for unite in blocker-resolver.service blocker-guard.service; do
    if ! blocker_unit_active "${unite}"; then
        note "${unite} $(m "inactif, relance par le self-heal" "inactive, restarted by self-heal")"
        systemctl start "${unite}" || blocker_err "$(m "relance de" "restarting") ${unite} $(m "en echec" "failed")"
    fi
done

# ---------------------------------------------------------------------------
# 6. Hook initramfs
# ---------------------------------------------------------------------------
# On verifie la presence du hook mais on ne regenere PAS l'initramfs
# automatiquement : « update-initramfs -u » toutes les 5 minutes userait le
# disque pour rien et masquerait les vraies mises a jour de noyau. Un ecart est
# signale, la correction est manuelle et documentee dans le README.
# Les emplacements dependent du generateur d'images de la distribution :
# blocker-os.sh les connait, ce script ne les suppose pas.
if [ "${BLOCKER_INITRAMFS}" != "aucun" ]; then
    while IFS= read -r h; do
        [ -n "${h}" ] || continue
        if [ ! -e "$h" ]; then
            note "$(m "hook initramfs manquant" "initramfs hook missing") : $h"
            note "$(m "le reinstaller puis relancer" "reinstall it, then run") : sudo /usr/lib/blocker-adulte/blocker-configure"
        fi
    done < <(blocker_initramfs_hook_paths)
fi

# ---------------------------------------------------------------------------
# Compte-rendu
# ---------------------------------------------------------------------------
if [ "${ecarts}" -eq 0 ]; then
    blocker_info "self-heal : $(m "aucun ecart detecte" "no drift detected")"
else
    blocker_notice "self-heal : ${ecarts} $(m "ecart(s) detecte(s) et corrige(s), detail ci-dessus" "drift(s) detected and fixed, details above")"
fi

exit 0
