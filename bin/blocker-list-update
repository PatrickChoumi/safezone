#!/bin/bash
# blocker-adulte — mise a jour des listes de blocage (composant 1)
#
# Installe dans : /usr/lib/blocker-adulte/blocker-list-update
# Lance par     : blocker-list-update.timer (quotidien)
#
# Telecharge les listes categorisees, les convertit au format dnsmasq, valide le
# resultat AVANT de le mettre en place, puis recharge le resolveur.
#
# En cas d'echec reseau ou de liste invalide, les listes en place sont
# conservees : une machine hors ligne garde son blocage.

set -uo pipefail

. /usr/lib/blocker-adulte/blocker-common.sh

blocker_require_root

DEST="${BLOCKER_STATEDIR}/blocklists"
WORK="$(mktemp -d)"
trap 'rm -rf "${WORK}"' EXIT

install -d -m 0755 "${DEST}"

# Convertit une liste au format « hosts » (0.0.0.0 domaine) OU au format
# dnsmasq natif (address=/domaine/) vers des directives dnsmasq.
convertir() {
    local src="$1" out="$2"
    awk '
        # Commentaires et lignes vides
        /^[[:space:]]*(#|$)/ { next }

        # Format dnsmasq natif : on reprend la ligne telle quelle
        /^(address|server|local)=\// { print; next }

        # Format hosts : "0.0.0.0 exemple.tld" ou "127.0.0.1 exemple.tld"
        /^(0\.0\.0\.0|127\.0\.0\.1|::)[[:space:]]+/ {
            domaine = $2
            if (domaine == "" ) next
            if (domaine == "localhost" || domaine == "localhost.localdomain") next
            if (domaine == "broadcasthost" || domaine == "local") next
            if (domaine ~ /^0\.0\.0\.0$/) next
            print "address=/" domaine "/#"
            next
        }
    ' "${src}" | sort -u > "${out}"
}

telecharger() {
    local url="$1" out="$2"
    curl --fail --silent --show-error --location \
         --max-time 60 --retry 2 --retry-delay 3 \
         --user-agent "blocker-adulte/1.0" \
         --output "${out}" "${url}"
}

total=0
fichiers_ok=()
index=10

while IFS= read -r url; do
    [ -n "${url}" ] || continue
    brut="${WORK}/brut-${index}"
    converti="${WORK}/$(printf '%02d' "${index}")-liste.conf"

    if ! telecharger "${url}" "${brut}"; then
        blocker_warn "$(m "telechargement echoue, liste ignoree" "download failed, list skipped") : ${url}"
        index=$((index + 1))
        continue
    fi

    convertir "${brut}" "${converti}"
    lignes="$(wc -l < "${converti}")"

    # Garde-fou : une liste vide ou minuscule signale une page d'erreur HTML
    # renvoyee avec un code 200, pas une vraie liste.
    if [ "${lignes}" -lt 100 ]; then
        blocker_warn "$(m "liste suspecte" "suspicious list") (${lignes} $(m "entrees seulement" "entries only")), $(m "ignoree" "skipped") : ${url}"
        index=$((index + 1))
        continue
    fi

    blocker_info "$(m "liste recuperee" "list fetched") : ${lignes} $(m "domaines depuis" "domains from") ${url}"
    fichiers_ok+=("${converti}")
    total=$((total + lignes))
    index=$((index + 1))
done <<< "${BLOCKER_LIST_URLS}"

if [ "${#fichiers_ok[@]}" -eq 0 ]; then
    blocker_warn "$(m "aucune liste telechargee, les listes en place sont conservees" \
                  "no list downloaded, the lists already in place are kept")"
    exit 0
fi

# --- Validation avant mise en place ----------------------------------------
# On construit l'arborescence candidate et on la fait valider par dnsmasq
# lui-meme. Une liste corrompue ne doit jamais empecher le resolveur de
# demarrer : sans DNS, la machine parait cassee et la premiere reaction de
# l'utilisateur est de tout desinstaller.
CANDIDAT="${WORK}/candidat"
install -d -m 0755 "${CANDIDAT}"
install -m 0644 "${BLOCKER_SHAREDIR}/blocklists/00-base.conf" "${CANDIDAT}/00-base.conf"
for f in "${fichiers_ok[@]}"; do
    install -m 0644 "${f}" "${CANDIDAT}/$(basename "${f}")"
done

TEST_CONF="${WORK}/test.conf"
sed "s#^conf-dir=.*#conf-dir=${CANDIDAT},*.conf#" \
    /etc/dnsmasq.d/blocker-adulte.conf > "${TEST_CONF}"

if ! dnsmasq --test --conf-file="${TEST_CONF}" >/dev/null 2>&1; then
    blocker_err "$(m "les listes telechargees produisent une configuration dnsmasq invalide, mise a jour abandonnee" \
                 "the downloaded lists produce an invalid dnsmasq configuration, update aborted")"
    dnsmasq --test --conf-file="${TEST_CONF}" >&2 || true
    exit 1
fi

# --- Mise en place ----------------------------------------------------------
# On retire les anciennes listes telechargees (10-*.conf et suivantes) mais
# jamais 00-base.conf, qui est le filet de securite hors ligne.
find "${DEST}" -maxdepth 1 -name '[1-9][0-9]-*.conf' -delete

for f in "${CANDIDAT}"/[1-9][0-9]-*.conf; do
    [ -e "${f}" ] || continue
    install -m 0644 "${f}" "${DEST}/$(basename "${f}")"
done

blocker_info "$(m "listes de blocage mises a jour" "blocklists updated") : ${total} $(m "domaines au total dans" "domains in total in") ${DEST}"

# --- SafeSearch force -------------------------------------------------------
# Les adresses des hotes « stricts » des moteurs changent : on les rafraichit en
# meme temps que les listes, dans la meme fenetre reseau.
if [ -x /usr/lib/blocker-adulte/blocker-safesearch ]; then
    /usr/lib/blocker-adulte/blocker-safesearch || \
        blocker_warn "$(m "rafraichissement SafeSearch en echec, les valeurs en place restent actives" \
                  "SafeSearch refresh failed, the values already in place stay active")"
fi

# --- Adresses des resolveurs DoH -------------------------------------------
# Les adresses ecrites en dur dans le jeu de regles vieillissent ; on les
# complete avec ce que les noms resolvent aujourd'hui.
if [ -x /usr/lib/blocker-adulte/blocker-doh-refresh ]; then
    /usr/lib/blocker-adulte/blocker-doh-refresh || \
        blocker_warn "$(m "rafraichissement des adresses DoH en echec, la liste ecrite en dur reste active" \
                  "DoH address refresh failed, the hard-coded list stays active")"
fi

# --- Rechargement du resolveur ---------------------------------------------
if blocker_unit_active blocker-resolver.service; then
    if systemctl reload-or-restart blocker-resolver.service; then
        blocker_info "$(m "resolveur recharge avec les nouvelles listes" "resolver reloaded with the new lists")"
    else
        blocker_err "$(m "rechargement du resolveur en echec" "reloading the resolver failed")"
    fi
fi

exit 0
