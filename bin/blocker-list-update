#!/bin/bash
# blocker-adulte — mise a jour des listes de blocage (composant 1)
#
# Installe dans : /usr/lib/blocker-adulte/blocker-list-update
# Lance par     : blocker-list-update.timer (quotidien)
#
# Telecharge les listes de BLOCKER_LIST_URLS, n'en retient que des noms de
# domaine valides, ecrit lui-meme les directives de blocage, fait valider le
# resultat par dnsmasq AVANT de le mettre en place, puis recharge le resolveur.
#
# TROIS REGLES, TIREES DES DEFAUTS DE LA VERSION PRECEDENTE
#
#   1. Une liste qui echoue garde sa version precedente. L'ancien script
#      effacait toutes les listes puis n'installait que celles qui avaient
#      reussi : une seule liste en echec (« --max-time 60 » sur une connexion
#      lente) disparaissait jusqu'a la reussite suivante.
#
#   2. Une liste nettement plus petite que la precedente (moins de la moitie)
#      est refusee : un telechargement tronque ou une page d'erreur ne doit pas
#      remplacer une liste complete.
#
#   3. Une liste exterieure ne fournit que des noms de domaine. Les lignes
#      « server= » d'une liste tierce etaient recopiees telles quelles, ce qui
#      laissait cette liste rediriger la resolution d'un domaine vers le serveur
#      de son choix. Voir lib/blocker-listes.sh.
#
# Chaque liste a un nom de fichier stable, derive de son URL
# (10-liste-<empreinte>.conf) : c'est ce qui permet de garder sa version
# precedente. L'ancien nettoyage visait « [1-9][0-9]-*.conf » et emportait au
# passage la liste personnelle 50-perso.conf, que la documentation disait
# pourtant jamais ecrasee.

set -uo pipefail

. /usr/lib/blocker-adulte/blocker-common.sh

blocker_require_root

DEST="${BLOCKER_LISTDIR}"
WORK="$(mktemp -d)"
trap 'rm -rf "${WORK}"' EXIT

install -d -m 0755 "${DEST}"

telecharger() {
    local url="$1" out="$2"
    curl --fail --silent --show-error --location \
         --connect-timeout 20 --max-time 900 \
         --speed-limit 1024 --speed-time 120 \
         --retry 3 --retry-delay 10 \
         --user-agent "blocker-adulte/1.0" \
         --output "${out}" "${url}"
}

nom_pour_url() {
    printf '10-liste-%s.conf' "$(printf '%s' "$1" | sha256sum | cut -c1-8)"
}

entete() {
    printf '# blocker-adulte — liste telechargee (generee, ne pas modifier)\n'
    printf '# Source : %s\n' "$1"
    printf '# Recuperee le %s ; seuls les noms de domaine valides sont retenus.\n' "$(date -Is)"
}

# ---------------------------------------------------------------------------
# Telechargement et conversion, liste par liste
# ---------------------------------------------------------------------------
declare -A attendus=()
nouvelles=()
gardees=0
total=0

while IFS= read -r url; do
    [ -n "${url}" ] || continue
    case "${url}" in
        https://*) ;;
        *) blocker_warn "$(m "URL ignoree (https requis)" "URL skipped (https required)") : ${url}"; continue ;;
    esac
    nom="$(nom_pour_url "${url}")"
    attendus["${nom}"]=1
    cible="${DEST}/${nom}"
    ancien=0
    [ -e "${cible}" ] && ancien="$(grep -c '^address=/' "${cible}" 2>/dev/null || true)"

    brut="${WORK}/brut"
    converti="${WORK}/converti"
    if ! telecharger "${url}" "${brut}"; then
        blocker_warn "$(m "telechargement echoue, version precedente conservee" "download failed, previous version kept") (${ancien}) : ${url}"
        gardees=$((gardees + 1)); total=$((total + ancien))
        continue
    fi

    blocker_convertir_liste "${brut}" "${converti}" "${BLOCKER_EXCEPTIONS}"
    rejets="$(blocker_conversion_rejets "${converti}")"
    lignes="$(wc -l < "${converti}")"

    # Une liste vide ou minuscule signale une page d'erreur HTML renvoyee avec
    # un code 200, pas une vraie liste.
    if [ "${lignes}" -lt 100 ]; then
        blocker_warn "$(m "liste suspecte" "suspicious list") (${lignes} $(m "entrees" "entries")), $(m "version precedente conservee" "previous version kept") : ${url}"
        gardees=$((gardees + 1)); total=$((total + ancien))
        continue
    fi
    if [ "${ancien}" -gt 0 ] && [ "${lignes}" -lt $((ancien / 2)) ]; then
        blocker_warn "$(m "liste nettement plus petite que la precedente" "list much smaller than the previous one") (${lignes} / ${ancien}), $(m "refusee" "rejected") : ${url}"
        gardees=$((gardees + 1)); total=$((total + ancien))
        continue
    fi
    if [ "${rejets}" -gt 0 ]; then
        blocker_info "${rejets} $(m "ligne(s) ecartee(s) (ni domaine valide ni commentaire)" "line(s) discarded (neither a valid domain nor a comment)") : ${url}"
    fi

    { entete "${url}"; cat "${converti}"; } > "${WORK}/${nom}"
    nouvelles+=("${nom}")
    total=$((total + lignes))
    blocker_info "$(m "liste recuperee" "list fetched") : ${lignes} $(m "domaines depuis" "domains from") ${url}"
done < <(blocker_mots "${BLOCKER_LIST_URLS:-}")

# ---------------------------------------------------------------------------
# Validation avant mise en place
# ---------------------------------------------------------------------------
# On reconstitue l'arborescence telle qu'elle sera apres la mise a jour et on
# la fait valider par dnsmasq lui-meme. Une liste corrompue ne doit jamais
# empecher le resolveur de demarrer : sans DNS, la machine parait cassee et la
# premiere reaction est de tout desinstaller.
if [ "${#nouvelles[@]}" -gt 0 ]; then
    CANDIDAT="${WORK}/candidat"
    install -d -m 0755 "${CANDIDAT}"
    for f in "${DEST}"/*.conf; do
        [ -e "${f}" ] && cp "${f}" "${CANDIDAT}/"
    done
    for nom in "${nouvelles[@]}"; do
        cp "${WORK}/${nom}" "${CANDIDAT}/${nom}"
    done
    TEST_CONF="${WORK}/test.conf"
    sed "s#^conf-dir=.*#conf-dir=${CANDIDAT},*.conf#" \
        /etc/dnsmasq.d/blocker-adulte.conf > "${TEST_CONF}"

    if command -v dnsmasq >/dev/null 2>&1 && \
       ! dnsmasq --test --conf-file="${TEST_CONF}" >/dev/null 2>&1; then
        blocker_err "$(m "les listes telechargees produisent une configuration dnsmasq invalide, mise a jour abandonnee" \
                         "the downloaded lists produce an invalid dnsmasq configuration, update aborted")"
        dnsmasq --test --conf-file="${TEST_CONF}" >&2 || true
        exit 1
    fi

    for nom in "${nouvelles[@]}"; do
        blocker_publier "${WORK}/${nom}" "${DEST}/${nom}" || \
            blocker_err "$(m "mise en place impossible" "cannot install") : ${nom}"
    done
fi

# ---------------------------------------------------------------------------
# Nettoyage : seulement les listes telechargees qui ne correspondent plus
# ---------------------------------------------------------------------------
# - une liste dont l'URL a ete retiree de blocker.conf (retrait soumis au
#   delai : il n'arrive ici qu'une fois approuve) ;
# - les fichiers a l'ancien nom (10-liste.conf, 11-liste.conf...), une fois
#   que chaque URL a sa liste au nouveau nom.
for f in "${DEST}"/10-liste-*.conf; do
    [ -e "${f}" ] || continue
    nom="$(basename "${f}")"
    if [ -z "${attendus[${nom}]:-}" ]; then
        blocker_retirer_gere "${f}"
        blocker_info "$(m "liste retiree (URL absente de la configuration)" "list removed (URL no longer configured)") : ${nom}"
    fi
done

complet=1
for nom in "${!attendus[@]}"; do
    [ -s "${DEST}/${nom}" ] || complet=0
done
if [ "${complet}" -eq 1 ]; then
    for f in "${DEST}"/[1-4][0-9]-liste.conf; do
        [ -e "${f}" ] || continue
        blocker_retirer_gere "${f}"
        blocker_info "$(m "ancienne liste remplacee" "old list replaced") : $(basename "${f}")"
    done
fi

if [ "${#nouvelles[@]}" -eq 0 ]; then
    blocker_warn "$(m "aucune liste mise a jour, les listes en place sont conservees" \
                      "no list updated, the lists already in place are kept")"
else
    blocker_info "$(m "listes de blocage mises a jour" "blocklists updated") : ${#nouvelles[@]} $(m "nouvelle(s)," "new,") ${gardees} $(m "conservee(s)," "kept,") ${total} $(m "domaines au total" "domains in total")"
fi

# --- Categories (moteurs sans filtre, interfaces alternatives) ---------------
# --reseau : les categories qui publient leurs adresses en ligne (Telegram)
# sont rafraichies une fois par jour, ici, plutot qu'a chaque passe.
/usr/lib/blocker-adulte/blocker-categories --reseau >/dev/null 2>&1
case "$?" in
    0|3) ;;
    *) blocker_warn "$(m "generation des categories en echec" "generating the categories failed")" ;;
esac

# --- SafeSearch force -------------------------------------------------------
# Les adresses des hotes « stricts » des moteurs changent : on les rafraichit en
# meme temps que les listes, dans la meme fenetre reseau.
if [ -x /usr/lib/blocker-adulte/blocker-safesearch ]; then
    /usr/lib/blocker-adulte/blocker-safesearch || \
        blocker_warn "$(m "rafraichissement SafeSearch en echec, les valeurs en place restent actives" \
                  "SafeSearch refresh failed, the values already in place stay active")"
fi

# --- Adresses des resolveurs DoH -------------------------------------------
if [ -x /usr/lib/blocker-adulte/blocker-doh-refresh ]; then
    /usr/lib/blocker-adulte/blocker-doh-refresh || \
        blocker_warn "$(m "rafraichissement des adresses DoH en echec, les adresses en place restent actives" \
                  "DoH address refresh failed, the addresses in place stay active")"
fi

# --- Rechargement du resolveur ---------------------------------------------
if blocker_unit_active blocker-resolver.service; then
    if systemctl restart blocker-resolver.service; then
        blocker_info "$(m "resolveur recharge avec les nouvelles listes" "resolver reloaded with the new lists")"
    else
        blocker_err "$(m "rechargement du resolveur en echec" "reloading the resolver failed")"
    fi
fi

exit 0
