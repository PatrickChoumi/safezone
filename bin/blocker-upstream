#!/bin/bash
# blocker-adulte — generation des resolveurs amont (composant 1)
#
# Installe dans : /usr/lib/blocker-adulte/blocker-upstream
# Lance par     : blocker-configure, blocker-selfheal et blocker-list-update
#
# POURQUOI CE SCRIPT EXISTE
#
# Les adresses amont etaient ecrites en dur dans /etc/dnsmasq.d/blocker-adulte.conf,
# que le self-heal restaure depuis son modele a chaque passe. Toute modification
# etait donc effacee dans les cinq minutes, alors que la documentation annoncait
# un reglage possible depuis blocker.conf : l'amont etait en pratique fige.
#
# Les adresses sont desormais generees ici, dans un fichier de la zone d'etat que
# le self-heal ne remplace pas. BLOCKER_UPSTREAM_1 / _2 de blocker.conf sont donc
# reellement maitres du reglage.
#
# L'amont compte : c'est la seconde barriere, independante des listes locales.
# Un amont filtrant bloque des domaines que nos listes n'ont pas encore vus.
#
# Ce script ecrit aussi ${BLOCKER_NFTDIR}/amonts.nft : les regles nftables
# n'exemptent le resolveur que vers ses amonts, sur le port 53. Un amont absent
# du jeu ecrit en dur dans les regles y est ajoute par ce fichier.

set -uo pipefail

. /usr/lib/blocker-adulte/blocker-common.sh

blocker_require_root

SORTIE="${BLOCKER_LISTDIR}/01-upstream.conf"
SORTIE_NFT="${BLOCKER_NFTDIR}/amonts.nft"

# Une adresse invalide empecherait dnsmasq de demarrer : la machine se
# retrouverait sans DNS du tout, ce qui pousse a tout desinstaller.
adresse_valide() {
    printf '%s' "$1" | grep -qE '^([0-9]{1,3}\.){3}[0-9]{1,3}$|^[0-9a-fA-F:]+$'
}

amonts=()
for a in "${BLOCKER_UPSTREAM_1:-}" "${BLOCKER_UPSTREAM_2:-}"; do
    [ -n "${a}" ] || continue
    if adresse_valide "${a}"; then
        amonts+=("${a}")
    else
        blocker_err "$(m "adresse amont invalide, ignoree" "invalid upstream address, skipped") : ${a}"
    fi
done

if [ "${#amonts[@]}" -eq 0 ]; then
    blocker_err "$(m "aucun resolveur amont valide dans" "no valid upstream resolver in") ${BLOCKER_CONF}"
    blocker_err "$(m "correction : renseigner BLOCKER_UPSTREAM_1 puis relancer ce script" \
                 "fix: set BLOCKER_UPSTREAM_1, then run this script again")"
    # On ne laisse pas un fichier vide : sans amont, dnsmasq ne resout plus rien.
    if [ -s "${SORTIE}" ]; then
        blocker_warn "$(m "le fichier en place est conserve" "the file already in place is kept")"
        exit 1
    fi
    blocker_warn "$(m "repli sur" "falling back to") Cloudflare for Families (1.1.1.3 / 1.0.0.3)"
    amonts=(1.1.1.3 1.0.0.3)
fi

WORK="$(mktemp)"
WORK_NFT="$(mktemp)"
trap 'rm -f "${WORK}" "${WORK_NFT}"' EXIT

# Jeu d'adresses nftables : un « add element » par famille. Les amonts deja
# presents en dur dans les regles y figurent aussi ; « auto-merge » absorbe les
# doublons.
v4=""; v6=""
for a in "${amonts[@]}"; do
    case "${a}" in
        *:*) v6="${v6:+${v6}, }${a}" ;;
        *)   v4="${v4:+${v4}, }${a}" ;;
    esac
done
{
    printf '# blocker-adulte — amonts exemptes de la redirection DNS (genere)\n'
    printf '# Genere par /usr/lib/blocker-adulte/blocker-upstream a partir de %s\n' "${BLOCKER_CONF_EN_VIGUEUR}"
    [ -n "${v4}" ] && printf 'add element ip blocker_adulte_nat amonts { %s }\n' "${v4}"
    [ -n "${v6}" ] && printf 'add element ip6 blocker_adulte_nat amonts6 { %s }\n' "${v6}"
} > "${WORK_NFT}"
blocker_publier "${WORK_NFT}" "${SORTIE_NFT}" || \
    blocker_err "$(m "ecriture du jeu d'amonts nftables impossible" "cannot write the nftables upstream set")"

{
    printf '# blocker-adulte — resolveurs amont (genere automatiquement)\n'
    printf '# Genere le %s par /usr/lib/blocker-adulte/blocker-upstream\n' "$(date -Is)"
    printf '#\n'
    printf '# NE PAS MODIFIER A LA MAIN : ce fichier est reecrit a partir de\n'
    printf '# BLOCKER_UPSTREAM_1 / BLOCKER_UPSTREAM_2 de %s\n' "${BLOCKER_CONF}"
    printf '#\n'
    printf '# Changer d amont :\n'
    printf '#   sudo nano %s\n' "${BLOCKER_CONF}"
    printf '#   sudo /usr/lib/blocker-adulte/blocker-upstream\n'
    printf '#   sudo systemctl restart blocker-resolver.service\n\n'
    for a in "${amonts[@]}"; do
        printf 'server=%s\n' "${a}"
    done
} > "${WORK}"

if command -v dnsmasq >/dev/null 2>&1; then
    if ! dnsmasq --test --conf-file="${WORK}" >/dev/null 2>&1; then
        blocker_err "$(m "le fichier d amont genere est invalide, mise en place abandonnee" \
                 "the generated upstream file is invalid, install aborted")"
        dnsmasq --test --conf-file="${WORK}" >&2 || true
        exit 1
    fi
fi

if [ -e "${SORTIE}" ] && \
   cmp -s <(grep '^server=' "${WORK}") <(grep '^server=' "${SORTIE}" 2>/dev/null); then
    # Inchange : on evite de reecrire et de faire croire a un ecart, mais on
    # s'assure que la reserve existe (premiere passe apres une mise a jour).
    [ -e "${BLOCKER_RESERVEDIR}/blocklists/01-upstream.conf" ] || \
        blocker_publier "${SORTIE}" "${SORTIE}"
    exit 0
fi

blocker_publier "${WORK}" "${SORTIE}" || exit 1
blocker_repair "$(m "resolveurs amont mis a jour" "upstream resolvers updated") : ${amonts[*]}"
exit 0
