#!/bin/bash
# blocker-adulte — SafeSearch force (composant 1)
#
# Installe dans : /usr/lib/blocker-adulte/blocker-safesearch
# Lance par     : blocker-list-update (quotidien) et blocker-selfheal si le
#                 fichier genere a disparu.
#
# POURQUOI CE COMPOSANT EST LE PLUS IMPORTANT DU LOT
#
# Une liste de blocage ne peut rien contre Google Images, YouTube ou Bing : ce
# sont des domaines qu'on ne peut pas bloquer sans rendre la machine
# inutilisable, et ils servent pourtant du contenu adulte a la demande.
#
# Les moteurs proposent tous un nom d'hote « verrouille en mode strict ».
# Resoudre www.google.com vers l'adresse de forcesafesearch.google.com force
# donc le SafeSearch au niveau du reseau : impossible a desactiver depuis les
# preferences du navigateur ou du compte, et valable pour tous les navigateurs
# et toutes les applications de la machine d'un seul coup.
#
# Les adresses de ces hotes changent : elles sont resolues a chaque passage
# plutot que codees en dur. Un moteur dont l'hote strict ne repond pas garde
# son entree precedente : il disparaissait auparavant du nouveau fichier, et
# donc du SafeSearch, jusqu'a la mise a jour suivante.

set -uo pipefail

. /usr/lib/blocker-adulte/blocker-common.sh

blocker_require_root

SORTIE="${BLOCKER_LISTDIR}/05-safesearch.conf"

# Desactivation explicite : on retire le fichier genere plutot que de le laisser
# trainer, sinon le resolveur continuerait a l'appliquer.
case "${BLOCKER_SAFESEARCH:-oui}" in
    non|no|0)
        if [ -e "${SORTIE}" ]; then
            blocker_retirer_gere "${SORTIE}"
            blocker_notice "$(m "SafeSearch desactive par configuration" "SafeSearch disabled by configuration"), ${SORTIE} $(m "retire" "removed")"
            systemctl reload-or-restart blocker-resolver.service 2>/dev/null || true
        fi
        exit 0
        ;;
esac

if ! command -v dig >/dev/null 2>&1; then
    blocker_err "SafeSearch : $(m "la commande dig est requise (paquet" "the dig command is required (package") $(blocker_pkg_pour_role dig))"
    exit 1
fi
WORK="$(mktemp -d)"
trap 'rm -rf "${WORK}"' EXIT

# ---------------------------------------------------------------------------
# Table des correspondances
# ---------------------------------------------------------------------------
# Format : <hote strict>|<domaine a rediriger> [<domaine> ...]
#
# On ne redirige JAMAIS un domaine nu comme « google.com » : « address= »
# s'applique aussi a tous ses sous-domaines, ce qui casserait Gmail, Drive,
# Agenda et l'authentification. Seuls les hotes de recherche sont vises.
#
# CRITERE D'ADMISSION D'UNE ENTREE
#
# Une entree n'a sa place ici que si le fournisseur publie un hote dedie qui
# applique le filtrage en se fondant sur l'ADRESSE jointe, independamment de
# l'en-tete Host. C'est ce que font Google, YouTube, Bing, DuckDuckGo et
# Yandex, et c'est la seule chose qu'une reecriture DNS peut exploiter.
#
# Un mecanisme par cookie ou par parametre d'URL (« ?safesearch=true ») est
# hors de portee : le DNS ne voit ni les cookies ni les URL. Rediriger dans ce
# cas ne filtre rien et risque de casser le site, ce qui est bien pire qu'une
# absence de filtrage — un site casse pousse a tout desinstaller.
#
# tests/test_safesearch.sh verifie automatiquement, pour CHAQUE entree, que
# l'adresse stricte differe de l'adresse normale du domaine cible. Une entree
# qui echoue a ce controle est structurellement incapable de forcer quoi que
# ce soit et fait echouer le test.
#
# --- Pixabay : entree retiree le 2026-08-15 ---------------------------------
# « safesearch.pixabay.com » resolvait bien vers une adresse distincte
# (103.169.142.8, hors des plages Cloudflare qui servent pixabay.com), mais
# rien n'etablit qu'elle serve le site en mode filtre :
#   - le SafeSearch documente par Pixabay passe par un cookie / le parametre
#     d'URL « ?safesearch=true », que le DNS ne peut pas influencer ;
#   - ce nom apparait surtout comme cible d'une regle de REECRITURE D'URL chez
#     un editeur de filtrage tiers, ce qui est un mecanisme applicatif, pas
#     une adresse dediee ;
#   - pixabay.com est servi par Cloudflare ; une adresse isolee hors de ces
#     plages ne peut pas servir le site avec un certificat valide.
# Le benefice n'etant pas etabli et le risque de casser pixabay.com bien reel,
# l'entree est retiree. Pour la retablir il faut d'abord verifier, sur une
# machine sans proxy interceptant :
#   curl -sI --resolve pixabay.com:443:<IP> https://pixabay.com/ | head -1
# et constater que la reponse vient bien de Pixabay en mode filtre.
#
# --- Format -----------------------------------------------------------------
# Un domaine prefixe de « = » est redirige pour ce NOM EXACT seulement
# (« host-record= ») : ses sous-domaines restent intacts. C'est ce qui permet
# de forcer la recherche de Yandex, servie sur le domaine nu yandex.ru, sans
# rediriger mail.yandex.ru ni disk.yandex.ru. Les autres lignes utilisent
# « address= », qui couvre aussi les sous-domaines.
#
# @GOOGLE@ est remplace par tous les domaines nationaux de Google, voir
# domaines_google().
correspondances() {
    cat <<'EOF'
forcesafesearch.google.com|@GOOGLE@
restrict.youtube.com|www.youtube.com m.youtube.com youtube.com youtubei.googleapis.com youtube.googleapis.com www.youtube-nocookie.com
strict.bing.com|www.bing.com bing.com cn.bing.com
safe.duckduckgo.com|duckduckgo.com www.duckduckgo.com start.duckduckgo.com html.duckduckgo.com lite.duckduckgo.com
familysearch.yandex.ru|=yandex.ru www.yandex.ru =yandex.com www.yandex.com =yandex.ua www.yandex.ua =yandex.by www.yandex.by =yandex.kz www.yandex.kz =yandex.uz www.yandex.uz =yandex.com.tr www.yandex.com.tr =yandex.az www.yandex.az =yandex.com.am www.yandex.com.am =yandex.com.ge www.yandex.com.ge =yandex.co.il www.yandex.co.il =yandex.kg www.yandex.kg =yandex.lt www.yandex.lt =yandex.lv www.yandex.lv =yandex.md www.yandex.md =yandex.tj www.yandex.tj =yandex.tm www.yandex.tm =yandex.ee www.yandex.ee =yandex.fr www.yandex.fr =ya.ru www.ya.ru
EOF
}

# ---------------------------------------------------------------------------
# Domaines de Google
# ---------------------------------------------------------------------------
# Une selection de 38 domaines laissait passer tous les autres : www.google.cm,
# par exemple, n'y figurait pas. On part de la liste officielle,
# https://www.google.com/supported_domains, telechargee a chaque passage, et on
# la reunit avec la copie integree ci-dessous. La reunion ne peut qu'ajouter :
# une liste officielle tronquee ou injoignable ne retire rien.
domaines_google_integres() {
    cat <<'EOF'
google.com google.ad google.ae google.com.af google.com.ag google.al google.am
google.co.ao google.com.ar google.as google.at google.com.au google.az google.ba
google.com.bd google.be google.bf google.bg google.com.bh google.bi google.bj
google.com.bn google.com.bo google.com.br google.bs google.bt google.co.bw
google.by google.com.bz google.ca google.cd google.cf google.cg google.ch
google.ci google.co.ck google.cl google.cm google.cn google.com.co google.co.cr
google.com.cu google.cv google.com.cy google.cz google.de google.dj google.dk
google.dm google.com.do google.dz google.com.ec google.ee google.com.eg
google.es google.com.et google.fi google.com.fj google.fm google.fr google.ga
google.ge google.gg google.com.gh google.com.gi google.gl google.gm google.gr
google.com.gt google.gy google.com.hk google.hn google.hr google.ht google.hu
google.co.id google.ie google.co.il google.im google.co.in google.iq google.is
google.it google.je google.com.jm google.jo google.co.jp google.co.ke
google.com.kh google.ki google.kg google.co.kr google.com.kw google.kz
google.la google.com.lb google.li google.lk google.co.ls google.lt google.lu
google.lv google.com.ly google.co.ma google.md google.me google.mg google.mk
google.ml google.com.mm google.mn google.com.mt google.mu google.mv google.mw
google.com.mx google.com.my google.co.mz google.com.na google.com.ng
google.com.ni google.ne google.nl google.no google.com.np google.nr google.nu
google.co.nz google.com.om google.com.pa google.com.pe google.com.pg
google.com.ph google.com.pk google.pl google.pn google.com.pr google.ps
google.pt google.com.py google.com.qa google.ro google.ru google.rw
google.com.sa google.com.sb google.sc google.se google.com.sg google.sh
google.si google.sk google.com.sl google.sn google.so google.sm google.sr
google.st google.com.sv google.td google.tg google.co.th google.com.tj
google.tl google.tm google.tn google.to google.com.tr google.tt google.com.tw
google.co.tz google.com.ua google.co.ug google.co.uk google.com.uy
google.co.uz google.com.vc google.co.ve google.co.vi google.com.vn google.vu
google.ws google.rs google.co.za google.co.zm google.co.zw google.cat
EOF
}

domaines_google() {
    local officielle="${WORK}/google-supported"
    {
        domaines_google_integres | tr ' ' '\n'
        if curl --fail --silent --location --max-time 20 \
                --user-agent "blocker-adulte/1.0" \
                --output "${officielle}" https://www.google.com/supported_domains 2>/dev/null; then
            # Une ligne par domaine, avec un point initial : « .google.cm ».
            # Tout ce qui ne ressemble pas a un domaine Google est ecarte.
            if [ "$(grep -cE '^\.google\.[a-z.]+$' "${officielle}")" -ge 100 ]; then
                grep -E '^\.google\.[a-z.]+$' "${officielle}" | sed 's/^\.//'
            fi
        fi
    } | grep -E '^google\.[a-z.]+$' | LC_ALL=C sort -u | sed 's/^/www./' | tr '\n' ' '
}

# ---------------------------------------------------------------------------
# Resolution
# ---------------------------------------------------------------------------
# Les regles nftables redirigent le port 53 vers le resolveur local, sauf pour
# l'utilisateur blocker-adulte. On resout donc sous cette identite quand c'est
# possible : la resolution aboutit alors meme si le resolveur local est arrete,
# ce qui est precisement le cas ou l'on a besoin de reconstruire ses listes.
resoudre() {
    local nom="$1" type="$2" sortie=""

    if command -v runuser >/dev/null 2>&1 && getent passwd "${BLOCKER_USER}" >/dev/null 2>&1; then
        sortie="$(runuser -u "${BLOCKER_USER}" -- \
            dig +short +time=4 +tries=2 "-t${type}" \
            "@${BLOCKER_UPSTREAM_1}" "${nom}" 2>/dev/null)"
    fi

    # Repli : resolveur local, puis resolution systeme.
    if [ -z "${sortie}" ]; then
        sortie="$(dig +short +time=4 +tries=2 "-t${type}" \
            "@${BLOCKER_LISTEN_ADDR}" "${nom}" 2>/dev/null)"
    fi
    if [ -z "${sortie}" ]; then
        sortie="$(dig +short +time=4 +tries=2 "-t${type}" "${nom}" 2>/dev/null)"
    fi

    # On ne garde que les adresses, en ecartant les CNAME intermediaires et
    # les adresses nulles qui signaleraient un domaine bloque par erreur.
    case "${type}" in
        A)    printf '%s\n' "${sortie}" | grep -E '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$' \
                  | grep -vE '^(0\.0\.0\.0|127\.)' ;;
        AAAA) printf '%s\n' "${sortie}" | grep -E '^[0-9a-fA-F:]+$' \
                  | grep -vE '^(::|::1)$' ;;
    esac
}

# ---------------------------------------------------------------------------
# Construction
# ---------------------------------------------------------------------------
CANDIDAT="${WORK}/05-safesearch.conf"

{
    printf '# blocker-adulte — SafeSearch force (genere automatiquement)\n'
    printf '# Genere le %s par /usr/lib/blocker-adulte/blocker-safesearch\n' "$(date -Is)"
    printf '#\n'
    printf '# NE PAS MODIFIER A LA MAIN : ce fichier est reecrit a chaque mise a jour\n'
    printf '# des listes. Pour desactiver le SafeSearch force, mettre\n'
    printf '# BLOCKER_SAFESEARCH="non" dans /etc/blocker-adulte/blocker.conf.\n'
    printf '#\n'
    printf '# Chaque ligne fait resoudre un moteur de recherche vers sa variante\n'
    printf '# verrouillee en mode strict. Le reglage devient impossible a changer\n'
    printf '# depuis le navigateur ou le compte utilisateur.\n\n'
} > "${CANDIDAT}"

moteurs_ok=0
moteurs_gardes=0
moteurs_echec=0
domaines_total=0
GOOGLE="$(domaines_google)"

# Section d'un moteur dans le fichier en place : de « # --- hote --- » a la
# ligne vide suivante.
section_precedente() {
    awk -v h="# --- $1 ---" '
        $0 == h { dedans = 1; print; next }
        dedans && /^$/ { exit }
        dedans { print }
    ' "${SORTIE}" 2>/dev/null
}

while IFS='|' read -r hote domaines; do
    [ -n "${hote}" ] || continue
    domaines="${domaines//@GOOGLE@/${GOOGLE}}"

    mapfile -t v4 < <(resoudre "${hote}" A)
    mapfile -t v6 < <(resoudre "${hote}" AAAA)

    if [ "${#v4[@]}" -eq 0 ] && [ "${#v6[@]}" -eq 0 ]; then
        precedente="$(section_precedente "${hote}")"
        if [ -n "${precedente}" ]; then
            printf '%s\n\n' "${precedente}" >> "${CANDIDAT}"
            blocker_warn "SafeSearch : ${hote} $(m "non resolu, entree precedente conservee" "did not resolve, previous entry kept")"
            moteurs_gardes=$((moteurs_gardes + 1))
        else
            blocker_warn "SafeSearch : ${hote} $(m "non resolu et aucune entree precedente" "did not resolve and no previous entry")"
            moteurs_echec=$((moteurs_echec + 1))
        fi
        continue
    fi

    {
        printf '# --- %s ---\n' "${hote}"
        for d in ${domaines}; do
            case "${d}" in
                =*)
                    for ip in "${v4[@]}" "${v6[@]}"; do
                        [ -n "${ip}" ] && printf 'host-record=%s,%s\n' "${d#=}" "${ip}"
                    done ;;
                *)
                    for ip in "${v4[@]}" "${v6[@]}"; do
                        [ -n "${ip}" ] && printf 'address=/%s/%s\n' "${d}" "${ip}"
                    done ;;
            esac
            domaines_total=$((domaines_total + 1))
        done
        printf '\n'
    } >> "${CANDIDAT}"

    blocker_info "SafeSearch : ${hote} -> ${v4[*]:-$(m "aucune IPv4" "no IPv4")} ${v6[*]:-}"
    moteurs_ok=$((moteurs_ok + 1))
done < <(correspondances)

# ---------------------------------------------------------------------------
# Validation avant mise en place
# ---------------------------------------------------------------------------
if [ "${moteurs_ok}" -eq 0 ]; then
    blocker_warn "SafeSearch : $(m "aucun moteur resolu (machine hors ligne ?)" "no engine resolved (machine offline?)")"
    if [ -s "${SORTIE}" ]; then
        blocker_info "SafeSearch : $(m "le fichier en place est conserve" "the file already in place is kept")"
        [ -e "${BLOCKER_RESERVEDIR}/blocklists/05-safesearch.conf" ] || blocker_publier "${SORTIE}" "${SORTIE}"
        exit 0
    fi
    blocker_err "SafeSearch : $(m "aucun fichier en place et aucune resolution possible" \
                              "no file in place and no resolution possible")"
    exit 1
fi

# Une configuration invalide empecherait le resolveur de demarrer : on la fait
# valider par dnsmasq lui-meme avant de la mettre en place.
if command -v dnsmasq >/dev/null 2>&1; then
    if ! dnsmasq --test --conf-file="${CANDIDAT}" >/dev/null 2>&1; then
        blocker_err "SafeSearch : $(m "le fichier genere est invalide, mise en place abandonnee" \
                              "the generated file is invalid, install aborted")"
        dnsmasq --test --conf-file="${CANDIDAT}" >&2 || true
        exit 1
    fi
fi

blocker_publier "${CANDIDAT}" "${SORTIE}" || exit 1

blocker_info "$(m "SafeSearch actif" "SafeSearch active") : ${moteurs_ok} $(m "moteur(s)" "engine(s)"), ${domaines_total} $(m "domaine(s) rediriges vers leur variante stricte" "domain(s) redirected to their strict variant")"
[ "${moteurs_gardes}" -gt 0 ] && \
    blocker_warn "SafeSearch : ${moteurs_gardes} $(m "moteur(s) sur leur entree precedente, nouvelle tentative a la prochaine mise a jour" "engine(s) on their previous entry, will retry at the next update")"
[ "${moteurs_echec}" -gt 0 ] && \
    blocker_warn "SafeSearch : ${moteurs_echec} $(m "moteur(s) sans aucune entree" "engine(s) with no entry at all")"

exit 0
