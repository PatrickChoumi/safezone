#!/bin/sh
# blocker-adulte — script de boot initramfs (composant 4)
#
# Installe dans : /etc/initramfs-tools/scripts/init-bottom/blocker-adulte
# Embarque dans l'image par : /etc/initramfs-tools/hooks/blocker-adulte
#
# S'execute dans l'initramfs, apres le montage du disque racine et juste avant
# le switch_root vers le systeme principal. Charge les regles nftables de base
# generees par le hook.
#
# Les regles nftables etant un etat du noyau, elles survivent au switch_root :
# elles restent donc actives en mode recovery / single-user, ou nftables.service
# et les deux watchdogs ne sont pas lances.
#
# Ce script ne touche ni au bootloader ni au firmware, et n'empeche jamais le
# demarrage : toute erreur est signalee puis ignoree (« exit 0 »).

PREREQ=""
prereqs() { echo "${PREREQ}"; }

case "${1:-}" in
    prereqs)
        prereqs
        exit 0
        ;;
esac

RULES="/etc/blocker-adulte/base.nft"

# La sortie de ce script est reprise par le journal du boot ; elle est visible
# via « journalctl -b -u systemd-journald » ou « dmesg » selon la configuration.
say() { echo "blocker-adulte (initramfs): $*"; }

# L'emplacement de nft depend de la disposition de l'image : usr-merge ou non,
# selon la version d'initramfs-tools et de la distribution. On cherche aux
# emplacements possibles plutot que d'en supposer un seul.
NFT=""
for candidat in /usr/sbin/nft /sbin/nft /usr/bin/nft /bin/nft; do
    if [ -x "${candidat}" ]; then NFT="${candidat}"; break; fi
done

[ -n "${NFT}" ] || { say "nft absent de l'initramfs, regles de base non chargees"; exit 0; }
[ -r "${RULES}" ] || { say "jeu de regles de base absent, rien a charger"; exit 0; }

# Les modules ont ete embarques par le hook, mais ils ne sont pas forcement
# charges a ce stade : nft les demande au noyau tout seul si l'autochargement
# fonctionne, sinon on aide un peu.
for module in nf_tables nft_chain_nat nft_redir nft_reject_inet; do
    modprobe "${module}" 2>/dev/null || true
done

if "${NFT}" -f "${RULES}" 2>/dev/null; then
    say "regles de base chargees (redirection DNS + blocage DoT/DoQ actifs des le boot)"
else
    say "ECHEC du chargement des regles de base ; le systeme principal les rechargera via nftables.service"
fi

exit 0
