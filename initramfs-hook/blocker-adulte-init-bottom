#!/bin/sh
# blocker-adulte — point d'entree initramfs-tools au demarrage (composant 4)
#
# Installe dans : /etc/initramfs-tools/scripts/init-bottom/blocker-adulte
# Embarque dans l'image par : /etc/initramfs-tools/hooks/blocker-adulte
#
# S'execute dans l'initramfs, apres le montage du disque racine et juste avant
# le switch_root. Tout le travail est fait par le chargeur commun aux trois
# generateurs d'images ; ce fichier n'existe que pour respecter la convention
# d'initramfs-tools (reponse a « prereqs »).

PREREQ=""
prereqs() { echo "${PREREQ}"; }

case "${1:-}" in
    prereqs)
        prereqs
        exit 0
        ;;
esac

if [ -x /usr/sbin/blocker-adulte-load-rules ]; then
    /usr/sbin/blocker-adulte-load-rules
else
    echo "blocker-adulte (initramfs): chargeur absent de l'image, regles non chargees"
fi

exit 0
